# Robot configuration
ROBOT_IP=192.168.123.18
# Per-device key, required by Go2 firmware 1.1.15+ (32 hex chars). Never commit it.
ROBOT_DEVICE_KEY=

# 0G Chain (Galileo Testnet)
RPC_URL=https://evmrpc-testnet.0g.ai
REGISTRY_ADDRESS=
DISPATCHER_ADDRESS=

# Keys, one per job (see Roles in README.md)
# Deploys and upgrades the contracts (contracts/scripts). Its address is their upgrade admin.
DEPLOYER_PRIVATE_KEY=
# Runs examples/operator-node.ts. Add its address as an operator on the robot.
OPERATOR_PRIVATE_KEY=
# Sends commands in examples/send-command.ts and send-ai-command.ts. Any funded wallet.
SENDER_PRIVATE_KEY=

# Robot identity
ROBOT_ID=

# Dashboard: these go in apps/dashboard/.env.local, or the Vercel project's env
# WalletConnect project ID from Reown
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# 0G faucet service API (issue #32). Server-only: never a NEXT_PUBLIC_ variable.
# Without the key, the audience page links to the public faucet instead.
# FAUCET_API_URL=https://faucet-api.udhaykumarbala.dev
# FAUCET_API_KEY=
